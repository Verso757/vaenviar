# Copia este archivo a .env y llena los valores reales.

# MySQL (Hostinger)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DBNAME"

# Si tu contraseña tiene caracteres especiales, puede ser necesario URL-encoding.
# Ejemplo: '!' => '%21'

# INSEGURO (solo uso interno / temporal):
# Si está en "true", el sistema guardará y validará contraseñas en texto plano.
# Déjalo en "false" para usar bcrypt (recomendado).
DISABLE_PASSWORD_HASH="false"

# SMTP (opcional)
# SMTP_HOST="smtp.tuempresa.com"
# SMTP_PORT="587"
# SMTP_USER="usuario_smtp"
# SMTP_PASS="password_smtp"
# SMTP_FROM="VaEnviar <no-reply@tuempresa.com>"
